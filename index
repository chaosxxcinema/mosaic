    localStorage.setItem('recipeMode', 'false');
    localStorage.removeItem('recipePage');
    
    // Clean up history state
    if(window.history.state && window.history.state.recipe){
      window.history.replaceState(null,'Mosaic',window.location.pathname);
    }
  } else {
    // Enter recipe mode - start at page 1
    currentRecipePage=1;
    disguisePage.classList.add('active');
    renderRecipe(currentRecipePage);
    updateRecipeTitle(currentRecipePage);
    
    // Save state to localStorage (persist across refreshes)
    localStorage.setItem('recipeMode', 'true');
    localStorage.setItem('recipePage', currentRecipePage.toString());
    
    // Push state to enable back button
    window.history.pushState({recipe:true, page:currentRecipePage},'Recipe','#recipe');
  }
});

// Handle browser back button - INFINITE LOOP through 9 recipes
window.addEventListener('popstate',e=>{
  if(currentRecipePage===0)return; // Not in recipe mode
  
  e.preventDefault();
  
  // Move to next page (cycle through 1-9)
  currentRecipePage++;
  if(currentRecipePage > totalRecipePages){
    currentRecipePage = 1; // Loop back to page 1
  }
  
  // Show recipe page
  renderRecipe(currentRecipePage);
  updateRecipeTitle(currentRecipePage);
  
  // Save current page
  localStorage.setItem('recipePage', currentRecipePage.toString());
  
  // Push new state to keep the loop going
  window.history.pushState({recipe:true, page:currentRecipePage},'Recipe','#recipe');
});

// Check recipe mode on page load
checkRecipeMode();

</script>
