<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mosaic — LGBTQ+ Global News</title>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}

:root{
  --glass-red:#e8463a; --glass-orange:#f07c3a; --glass-yellow:#f5c842;
  --glass-green:#3a9e5f; --glass-blue:#3a6fe8; --glass-violet:#8a3ae8;
  --glass-pink:#e83a7c; --glass-teal:#3ab8c8;
  --bg:#f5f2ed; --surface:#fdfcf9;
  --border:rgba(0,0,0,0.08); --border2:rgba(0,0,0,0.05);
  --text:#1a1612; --text-mid:#4a4238; --text-dim:#9a8f84;
  --sidebar-w:220px;
  --topbar-h:52px;
  --filterbar-h:42px;
}

html,body{height:100%;overflow:hidden;}
body{font-family:'DM Sans','Noto Sans TC',sans-serif;background:var(--bg);color:var(--text);display:flex;flex-direction:column;}

/* ── TOPBAR — newspaper header ── */
.topbar{
  height:var(--topbar-h);flex-shrink:0;
  background:var(--surface);
  border-bottom:2px solid var(--text);  /* newspaper thick rule */
  display:flex;align-items:center;
  padding:0 18px;gap:14px;
  position:relative;z-index:100;
}

/* Mosaic glass-shard logo mark — 6-color rainbow flag with sunlight refraction */
.logo-mark{display:flex;align-items:flex-end;gap:2px;flex-shrink:0;height:26px;position:relative;overflow:visible;}
.shard{width:5px;border-radius:1px;transform-origin:bottom center;position:relative;overflow:hidden;}
.shard::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,transparent 0%,rgba(255,255,255,.5) 45%,rgba(255,255,255,.9) 50%,rgba(255,255,255,.5) 55%,transparent 100%);
  transform:translateX(-150%);
  animation:sunlight-sweep 12s ease-in-out infinite;
}
.shard:nth-child(1){height:16px;background:var(--glass-red);}
.shard:nth-child(2){height:21px;background:var(--glass-orange);animation-delay:.4s;}
.shard:nth-child(2)::after{animation-delay:.4s;}
.shard:nth-child(3){height:26px;background:var(--glass-yellow);animation-delay:.8s;}
.shard:nth-child(3)::after{animation-delay:.8s;}
.shard:nth-child(4){height:23px;background:var(--glass-green);animation-delay:1.2s;}
.shard:nth-child(4)::after{animation-delay:1.2s;}
.shard:nth-child(5){height:18px;background:var(--glass-blue);animation-delay:1.6s;}
.shard:nth-child(5)::after{animation-delay:1.6s;}
.shard:nth-child(6){height:13px;background:var(--glass-violet);animation-delay:2s;}
.shard:nth-child(6)::after{animation-delay:2s;}

@keyframes sunlight-sweep{
  0%{transform:translateX(-150%);}
  15%{transform:translateX(150%);}
  100%{transform:translateX(150%);}
}

.logo-text{font-family:'DM Sans',sans-serif;font-weight:800;font-size:22px;color:var(--text);letter-spacing:-.02em;flex-shrink:0;}

/* Newspaper date + weather — centre of topbar */
.newspaper-meta{
  flex:1;min-width:0;text-align:center;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  overflow:hidden;
}
.newspaper-date{
  font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.06em;
  text-transform:uppercase;color:var(--text-dim);line-height:1;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;
}
.newspaper-tagline{
  font-family:'Libre Baskerville',serif;font-style:italic;
  font-size:9px;color:var(--text-dim);letter-spacing:.04em;
  margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;
}

/* Weather badge — compact, icon + temp only */
.weather-badge{
  display:flex;align-items:center;gap:3px;flex-shrink:0;
  font-family:'DM Mono',monospace;font-size:11px;color:var(--text-dim);
  background:var(--bg);border:1px solid var(--border);
  border-radius:6px;padding:3px 7px;
  white-space:nowrap;max-width:70px;overflow:hidden;
}
.weather-icon{font-size:13px;line-height:1;flex-shrink:0;}

/* Lang toggle */
.lang-toggle{display:flex;gap:2px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:3px;flex-shrink:0;}
.lang-btn{padding:4px 11px;border-radius:5px;border:none;background:transparent;color:var(--text-dim);font-family:'DM Mono',monospace;font-size:10px;letter-spacing:.04em;cursor:pointer;transition:all .16s;}
.lang-btn.active{background:var(--surface);color:var(--text);box-shadow:0 1px 3px rgba(0,0,0,.08);}

/* Mobile toggle - now visible on all screen sizes */
.sidebar-toggle{display:flex;width:32px;height:32px;border-radius:7px;background:var(--bg);border:1px solid var(--border);color:var(--text-mid);font-size:15px;cursor:pointer;align-items:center;justify-content:center;flex-shrink:0;transition:all .16s;}
.sidebar-toggle:hover{background:var(--glass-blue);color:#fff;border-color:var(--glass-blue);}

/* ── QUOTE BAR — Harvey Milk ── */
.quote-bar{
  flex-shrink:0;
  background:var(--surface);
  border-bottom:1px solid var(--border2);
  padding:7px 18px;
  text-align:center;
}
.quote-text{
  font-family:'Libre Baskerville',serif;
  font-style:italic;
  font-size:12px;
  color:var(--text-mid);
  letter-spacing:.01em;
  line-height:1.5;
}
.quote-author{
  font-family:'DM Mono',monospace;
  font-size:9px;
  color:var(--text-dim);
  letter-spacing:.08em;
  text-transform:uppercase;
  margin-left:8px;
}

/* ── FILTER BAR ── */
.filterbar{
  height:var(--filterbar-h);flex-shrink:0;
  background:var(--bg);
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;
  padding:0 18px;gap:8px;
  position:relative;z-index:99;
}

/* Search */
.search-wrap{flex:1;position:relative;min-width:0;}
.search-input{
  width:100%;
  background:var(--surface);border:1px solid var(--border);border-radius:7px;
  padding:6px 30px 6px 12px;
  font-family:'DM Sans',sans-serif;font-size:12.5px;color:var(--text);
  outline:none;transition:border-color .18s,box-shadow .18s;
}
.search-input:focus{border-color:var(--glass-blue);box-shadow:0 0 0 3px rgba(58,111,232,.08);}
.search-input::placeholder{color:var(--text-dim);}
.search-icon{position:absolute;right:10px;top:50%;transform:translateY(-50%);color:var(--text-dim);font-size:12px;pointer-events:none;}
.search-clear{position:absolute;right:8px;top:50%;transform:translateY(-50%);color:var(--text-dim);font-size:12px;cursor:pointer;display:none;background:none;border:none;line-height:1;}

/* Date inputs — compact */
.date-field{position:relative;display:inline-flex;align-items:center;flex-shrink:0;}
.date-disp{
  background:var(--surface);border:1px solid var(--border);border-radius:7px;
  padding:4px 18px 4px 7px;color:var(--text-mid);
  font-family:'DM Mono',monospace;font-size:9.5px;
  white-space:nowrap;min-width:78px;pointer-events:none;line-height:1.4;
}
.date-field input[type=date]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;}
.date-arrow{font-family:'DM Mono',monospace;font-size:10px;color:var(--text-dim);flex-shrink:0;}

.btn-filter{padding:5px 12px;border-radius:7px;background:var(--text);color:#fff;border:none;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:600;cursor:pointer;transition:all .16s;white-space:nowrap;}
.btn-filter:hover{background:#2a2018;}
.btn-reset{padding:5px 9px;border-radius:7px;background:transparent;border:1px solid var(--border);color:var(--text-dim);font-family:'DM Sans',sans-serif;font-size:11px;cursor:pointer;transition:all .16s;}
.btn-reset:hover{color:var(--text);}

/* Active tag badge in filterbar */
.active-tag-badge{
  display:none;align-items:center;gap:5px;flex-shrink:0;
  background:rgba(58,111,232,.1);border:1px solid rgba(58,111,232,.25);
  border-radius:999px;padding:3px 10px;
  font-family:'DM Sans',sans-serif;font-size:11px;color:var(--glass-blue);white-space:nowrap;
}
.active-tag-badge.show{display:inline-flex;}
.atb-clear{background:none;border:none;color:rgba(58,111,232,.6);font-size:12px;cursor:pointer;line-height:1;padding:0;margin-left:2px;}
.atb-clear:hover{color:var(--glass-blue);}

/* ── LAYOUT ── */
.layout{flex:1;min-height:0;display:flex;overflow:hidden;}

/* ── SIDEBAR ── collapsible on all screen sizes */
.sidebar{
  width:var(--sidebar-w);flex-shrink:0;
  background:var(--surface);border-right:1px solid var(--border);
  display:flex;flex-direction:column;
  overflow-y:auto;overflow-x:hidden;
  position:fixed;left:0;top:calc(var(--topbar-h) + var(--filterbar-h));bottom:0;
  z-index:200;
  transform:translateX(-100%);
  transition:transform .22s ease;
  box-shadow:4px 0 20px rgba(0,0,0,.12);
}
.sidebar.open{transform:translateX(0);}
.sidebar::-webkit-scrollbar{display:none;}

.sidebar-top{flex:1;padding:14px 0 0;}

.sidebar-section{margin-bottom:4px;}
.sidebar-label{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--text-dim);padding:4px 16px 5px;}

.nav-item{display:flex;align-items:center;gap:9px;padding:7px 16px;cursor:pointer;position:relative;transition:background .14s;font-size:13px;font-weight:500;color:var(--text-mid);}
.nav-item:hover{background:var(--bg);}
.nav-item.active{background:var(--bg);color:var(--text);font-weight:600;}
.nav-item.active::before{content:'';position:absolute;left:0;top:18%;bottom:18%;width:3px;border-radius:0 3px 3px 0;background:var(--item-color,var(--glass-blue));}
.nav-icon{width:21px;height:21px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0;background:color-mix(in srgb,var(--item-color,var(--glass-blue)) 14%,transparent);}
.nav-count{margin-left:auto;font-family:'DM Mono',monospace;font-size:10px;color:var(--text-dim);background:var(--bg);border:1px solid var(--border);border-radius:999px;padding:1px 6px;}
#count-guest{display:none;} /* Hide count for guest submissions */

.sidebar-divider{height:1px;background:var(--border2);margin:6px 14px;}

.country-item{display:flex;align-items:center;gap:8px;padding:5px 16px;cursor:pointer;font-size:12px;color:var(--text-mid);transition:background .14s;}
.country-item:hover{background:var(--bg);}
.country-item.active{background:var(--bg);color:var(--text);font-weight:600;}
.flag{font-size:15px;flex-shrink:0;}
.country-new{font-size:10px;background:rgba(16,185,129,.18);color:rgba(5,150,105,1);border:1px solid rgba(16,185,129,.45);border-radius:999px;padding:2px 7px;margin-left:auto;font-weight:700;letter-spacing:.05em;}

.sources-text{padding:4px 16px 10px;font-size:10.5px;color:var(--text-dim);line-height:1.75;}

/* ── SIDEBAR BOTTOM ── */
.sidebar-bottom{
  flex-shrink:0;
  border-top:1px solid var(--border);
  padding:12px 14px;
  display:flex;flex-direction:column;gap:8px;
}
.sb-kofi{
  display:inline-flex;align-items:center;gap:6px;
  background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.35);
  border-radius:999px;padding:5px 12px;
  color:rgba(5,150,105,.95);
  font-family:'DM Sans',sans-serif;font-size:11px;font-weight:600;
  text-decoration:none;transition:all .18s;width:100%;justify-content:center;
}
.sb-kofi:hover{background:rgba(16,185,129,.22);border-color:rgba(16,185,129,.55);}
.sb-links{display:flex;justify-content:center;gap:12px;}
.sb-link{
  font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.06em;
  color:var(--text-dim);text-decoration:none;cursor:pointer;
  transition:color .16s;text-transform:uppercase;background:none;border:none;
}
.sb-link:hover{color:var(--text);}
.sb-credit{
  font-family:'DM Mono',monospace;font-size:9px;
  color:var(--text-dim);text-align:center;letter-spacing:.04em;
  opacity:.65;
}

/* ── MAIN ── */
.main{flex:1;min-width:0;display:flex;flex-direction:column;overflow:hidden;}
.content-header{flex-shrink:0;padding:14px 22px 12px;border-bottom:1px solid var(--border2);display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;}
.content-title{font-family:'Libre Baskerville',serif;font-size:19px;font-weight:700;letter-spacing:-.01em;color:var(--text);}
.content-count{font-family:'DM Mono',monospace;font-size:11px;color:var(--text-dim);}
.content-hint{font-size:11.5px;color:var(--text-dim);margin-left:auto;}

.cards-scroll{flex:1;min-height:0;overflow-y:auto;padding:18px 22px 32px;scrollbar-width:thin;scrollbar-color:rgba(0,0,0,.1) transparent;}
.cards-scroll::-webkit-scrollbar{width:5px;}
.cards-scroll::-webkit-scrollbar-thumb{background:rgba(0,0,0,.1);border-radius:3px;}

/* ── CARD ── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:15px 17px;margin-bottom:9px;cursor:pointer;transition:box-shadow .18s,transform .18s,border-color .18s;position:relative;overflow:hidden;display:flex;gap:13px;align-items:flex-start;}
.card:hover{box-shadow:0 4px 18px rgba(0,0,0,.08);transform:translateY(-1px);border-color:rgba(0,0,0,.14);}
.card-strip{position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:10px 0 0 10px;}
.card-body{flex:1;min-width:0;}
.card-meta{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-bottom:5px;}
.card-source{font-family:'DM Mono',monospace;font-size:10px;font-weight:500;color:var(--text-dim);letter-spacing:.04em;text-transform:uppercase;}
.card-date{font-family:'DM Mono',monospace;font-size:10px;color:var(--text-dim);}
.card-geo{display:inline-flex;align-items:center;gap:3px;font-size:10px;color:var(--text-dim);background:var(--bg);border:1px solid var(--border);border-radius:999px;padding:1px 7px;}

.card-title{font-family:'Libre Baskerville',serif;font-size:14.5px;font-weight:700;line-height:1.45;color:var(--text);margin-bottom:5px;}
.card-title.zh{font-family:'Noto Sans TC',sans-serif;font-size:13.5px;}
.card-summary{font-size:12px;color:var(--text-mid);line-height:1.72;margin-bottom:9px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.card-tags{display:flex;flex-wrap:wrap;gap:4px;}

.ctag{display:inline-flex;align-items:center;gap:2px;padding:2px 8px;border-radius:999px;font-size:10px;font-family:'DM Sans',sans-serif;font-weight:500;border:1px solid;white-space:nowrap;cursor:pointer;transition:all .14s;}
.ctag:hover{filter:brightness(.92);transform:scale(1.04);}
.ctag.tag-active{outline:2px solid currentColor;outline-offset:1px;}
.ct-news{color:#c0390d;border-color:rgba(192,57,13,.24);background:rgba(192,57,13,.07);}
.ct-event{color:#1a5fc8;border-color:rgba(26,95,200,.24);background:rgba(26,95,200,.07);}
.ct-legal{color:#6b24c8;border-color:rgba(107,36,200,.24);background:rgba(107,36,200,.07);}
.ct-health{color:#1f8a4f;border-color:rgba(31,138,79,.24);background:rgba(31,138,79,.07);}
.ct-urgent{color:#c8241f;border-color:rgba(200,36,31,.34);background:rgba(200,36,31,.1);font-weight:700;}
.ct-ban{color:#c8241f;border-color:rgba(200,36,31,.28);background:rgba(200,36,31,.08);font-weight:600;}
.ct-persecution{color:#8b1a1a;border-color:rgba(139,26,26,.3);background:rgba(139,26,26,.09);font-weight:600;}
.ct-rollback{color:#b8560a;border-color:rgba(184,86,10,.28);background:rgba(184,86,10,.08);font-weight:600;}
.ct-resistance{color:#059669;border-color:rgba(5,150,105,.28);background:rgba(5,150,105,.08);font-weight:500;}
.ct-cn{color:#b07020;border-color:rgba(176,112,32,.24);background:rgba(176,112,32,.07);}
.ct-us{color:#1a5fc8;border-color:rgba(26,95,200,.18);background:rgba(26,95,200,.06);}
.ct-free{color:#1f8a4f;border-color:rgba(31,138,79,.2);background:rgba(31,138,79,.06);}

.card-link{flex-shrink:0;display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:7px;background:var(--bg);border:1px solid var(--border);color:var(--text-dim);font-size:13px;text-decoration:none;transition:all .16s;align-self:center;}
.card-link:hover{background:var(--glass-blue);border-color:var(--glass-blue);color:#fff;}

.hl{background:rgba(245,200,66,.45);border-radius:2px;padding:0 1px;}
.empty{text-align:center;padding:60px 20px;color:var(--text-dim);font-family:'Libre Baskerville',serif;font-style:italic;font-size:17px;display:none;}

/* Pagination */
.pagination{display:flex;align-items:center;justify-content:center;gap:8px;padding:20px;margin-top:10px;}
.pagination-btn{display:flex;align-items:center;justify-content:center;min-width:36px;height:36px;padding:0 12px;border-radius:7px;border:1px solid var(--border);background:var(--surface);color:var(--text-mid);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:all .16s;}
.pagination-btn:hover:not(:disabled){background:var(--glass-blue);color:#fff;border-color:var(--glass-blue);}
.pagination-btn:disabled{opacity:.4;cursor:not-allowed;}
.pagination-btn.active{background:var(--glass-blue);color:#fff;border-color:var(--glass-blue);font-weight:600;}
.pagination-info{font-size:12px;color:var(--text-dim);padding:0 8px;}

/* ── DETAIL OVERLAY ── */
.overlay{position:fixed;inset:0;background:rgba(26,22,18,.52);backdrop-filter:blur(6px);z-index:500;display:flex;justify-content:flex-end;opacity:0;pointer-events:none;transition:opacity .22s;}
.overlay.open{opacity:1;pointer-events:all;}
.detail-panel{width:min(520px,95vw);height:100%;background:var(--surface);border-left:1px solid var(--border);display:flex;flex-direction:column;transform:translateX(100%);transition:transform .24s cubic-bezier(.4,0,.2,1);overflow:hidden;}
.overlay.open .detail-panel{transform:translateX(0);}
.panel-header{flex-shrink:0;padding:18px 20px 14px;border-bottom:1px solid var(--border2);display:flex;align-items:flex-start;gap:10px;}
.panel-strip{width:4px;height:38px;border-radius:2px;flex-shrink:0;margin-top:2px;}
.panel-source-date{font-family:'DM Mono',monospace;font-size:10px;color:var(--text-dim);letter-spacing:.04em;margin-bottom:4px;}
.panel-title{font-family:'Libre Baskerville',serif;font-size:16px;font-weight:700;line-height:1.4;color:var(--text);flex:1;}
.panel-close{width:28px;height:28px;border-radius:7px;background:var(--bg);border:1px solid var(--border);color:var(--text-dim);font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .16s;flex-shrink:0;}
.panel-close:hover{background:#fde4e4;border-color:#f5a0a0;color:#c8241f;}
.panel-body{flex:1;overflow-y:auto;padding:18px 20px 28px;}
.panel-body::-webkit-scrollbar{width:4px;}
.panel-body::-webkit-scrollbar-thumb{background:rgba(0,0,0,.1);border-radius:2px;}
.panel-summary-box{background:var(--bg);border-radius:8px;padding:13px 15px;margin-bottom:14px;border-left:3px solid var(--panel-color,var(--glass-blue));}
.panel-summary-label{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--text-dim);margin-bottom:5px;}
.panel-summary-text{font-size:13px;line-height:1.85;color:var(--text);}
.panel-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px;}
.panel-tags .ctag{font-size:11.5px;padding:3px 11px;cursor:pointer;}
.panel-full-text{font-size:12.5px;line-height:1.9;color:var(--text-mid);margin-bottom:20px;white-space:pre-wrap;}
.panel-cta{display:inline-flex;align-items:center;gap:6px;background:var(--text);color:#fff;border:none;border-radius:8px;padding:9px 18px;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;text-decoration:none;cursor:pointer;transition:all .18s;}
.panel-cta:hover{background:#2a2018;transform:translateY(-1px);}

/* Guest article panel additions */
.panel-author-box{background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.22);border-radius:8px;padding:12px 14px;margin-bottom:14px;}
.panel-author-label{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:rgba(5,150,105,.8);margin-bottom:5px;font-weight:600;}
.panel-author-name{font-size:13px;font-weight:600;color:var(--text);margin-bottom:3px;}
.panel-author-bio{font-size:11.5px;color:var(--text-mid);line-height:1.6;}
.panel-listen-btn{display:inline-flex;align-items:center;gap:6px;background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.35);color:rgba(5,150,105,.95);border-radius:8px;padding:8px 16px;font-family:'DM Sans',sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:all .18s;margin-bottom:16px;}
.panel-listen-btn:hover{background:rgba(16,185,129,.22);border-color:rgba(16,185,105,.55);}
